---
extends: default

rules:
  line-length:
    max: 120
    level: error
  document-start:
    present: true
    level: warning
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

ignore: |
  ansible/group_vars/all/vault.yml
  ansible/collections/
  ansible/roles/geerlingguy.git/
  terraform/.terraform/
